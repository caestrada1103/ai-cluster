# AI Cluster Environment Configuration
# ======================================
# Copy this file to .env and adjust for your setup.

# ── Which worker to build/run ───────────────────────────────────────────────
# docker-compose.yml defines one worker service per GPU vendor/backend, each
# gated behind a Compose profile — `docker compose up -d` with NO profile set
# starts coordinator + monitoring + open-webui but deliberately NO worker (no
# vendor is silently assumed). Uncomment exactly ONE line below to match your
# hardware, or pass --profile <name> on the CLI instead. See docs/deployment.md
# for the full walkthrough per GPU (RTX 3080 / RX 9060XT / DGX Spark / multi-GPU).
#
# COMPOSE_PROFILES=amd-vulkan       # AMD (e.g. RX 9060XT) — universal Vulkan image
# COMPOSE_PROFILES=nvidia-vulkan    # NVIDIA (e.g. RTX 3080, or DGX Spark as a fallback) — universal Vulkan image
# COMPOSE_PROFILES=intel-vulkan     # Intel iGPU/dGPU — universal Vulkan image (Mesa ANV)
# COMPOSE_PROFILES=rocm-native      # AMD, native ROCm build — best AMD performance
# COMPOSE_PROFILES=cuda-native      # NVIDIA, native CUDA build (incl. DGX Spark/sm_121) — best NVIDIA performance
COMPOSE_PROFILES=

# ── Worker ────────────────────────────────────────────────────────────────────

# GPU index for the default worker (0-based)
GPU_INDEX=0

# Base ports — each worker replica listens on BASE + GPU_INDEX.
GRPC_BASE_PORT=50051
METRICS_BASE_PORT=9091
# Explicit port overrides (leave empty to derive from BASE + GPU_INDEX).
# When set, compose publishes and the worker binds the SAME value.
GRPC_PORT=
METRICS_PORT=

# HuggingFace Hub token for gated model downloads
HF_TOKEN=

# Logging level
RUST_LOG=info

# Rust panic backtrace (set to `full` for verbose output)
RUST_BACKTRACE=1

# Unique worker identifier (auto-assigned if empty)
WORKER_ID=

# GPU memory per worker (in GB)
GPU_VRAM_GB=6

# Comma-separated GPU device indices for one worker process (CLI --gpu-ids equivalent)
GPU_IDS=

# Worker log level and JSON logging toggle (clap env vars)
LOG_LEVEL=info
LOG_JSON=

# ── Coordinator ───────────────────────────────────────────────────────────────

# Allowed CORS origins, comma-separated. Restrict in production.
# Example: COORDINATOR_CORS_ORIGINS=https://myapp.example.com
COORDINATOR_CORS_ORIGINS=*

# ── Monitoring ────────────────────────────────────────────────────────────────

# Grafana admin credentials (GRAFANA_ADMIN_PASSWORD is required — no default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Integrations ─────────────────────────────────────────────────────────────

# API key passed to Open-WebUI for calls to the coordinator's /v1 endpoint
OPENAI_API_KEY=