# AI Cluster Environment Configuration
# ======================================
# Copy this file to .env and adjust for your setup.

# ── Which worker to build/run ───────────────────────────────────────────────
# docker-compose.yml defines one worker service per GPU vendor/backend, each
# gated behind a Compose profile — `docker compose up -d` with NO profile set
# starts coordinator + monitoring + open-webui but deliberately NO worker (no
# vendor is silently assumed). Uncomment exactly ONE line below to match your
# hardware, or pass --profile <name> on the CLI instead. See docs/deployment.md
# for the full walkthrough per GPU (RTX 3080 / RX 9060XT / DGX Spark / multi-GPU).
#
# COMPOSE_PROFILES=amd-vulkan       # AMD (e.g. RX 9060XT) — universal Vulkan image
# COMPOSE_PROFILES=nvidia-vulkan    # NVIDIA (e.g. RTX 3080, or DGX Spark as a fallback) — universal Vulkan image
# COMPOSE_PROFILES=intel-vulkan     # Intel iGPU/dGPU — universal Vulkan image (Mesa ANV)
# COMPOSE_PROFILES=rocm-native      # AMD, native ROCm build — best AMD performance
# COMPOSE_PROFILES=cuda-native      # NVIDIA, native CUDA build (incl. DGX Spark/sm_121) — best NVIDIA performance
COMPOSE_PROFILES=

# ── Worker ────────────────────────────────────────────────────────────────────

# GPU index for the default worker (0-based)
GPU_INDEX=0

# Base ports — each worker replica listens on BASE + GPU_INDEX.
GRPC_BASE_PORT=50051
METRICS_BASE_PORT=9091
# Explicit port overrides (leave empty to derive from BASE + GPU_INDEX).
# SECURITY (C1/H1): as of this project's security hardening, docker-compose.yml
# no longer publishes ANY worker port (gRPC/metrics/llama-server) to the host by
# default — the worker container still binds them internally so the coordinator
# container can reach it over the private compose network. To actually publish
# these to the host (LAN cluster: coordinator on another machine; or you want to
# hit a worker's metrics/gRPC directly), layer docker-compose.expose-ports.yml:
#   docker compose -f docker-compose.yml -f docker-compose.expose-ports.yml \
#     --profile <your-profile> up -d
# See that file's header comment and docs/deployment.md.
GRPC_PORT=
METRICS_PORT=

# Shared-secret gRPC auth (worker/src/grpc_auth.rs, C1). The worker's gRPC
# server has no TLS/mTLS — this is the deliverable in its place. Leave empty
# for a single-host compose deployment (the worker port isn't published, so
# only sibling containers on the private network can reach it). REQUIRED once
# you publish a worker's gRPC port via docker-compose.expose-ports.yml or run
# a worker on a separate LAN host the coordinator dials directly — generate
# one with e.g. `openssl rand -hex 32`.
WORKER_GRPC_AUTH_TOKEN=

# HuggingFace Hub token for gated model downloads
HF_TOKEN=

# Logging level
RUST_LOG=info

# Rust panic backtrace (set to `full` for verbose output)
RUST_BACKTRACE=1

# Unique worker identifier (auto-assigned if empty)
WORKER_ID=

# GPU memory per worker (in GB)
GPU_VRAM_GB=6

# Comma-separated GPU device indices for one worker process (CLI --gpu-ids equivalent)
GPU_IDS=

# Worker log level and JSON logging toggle (clap env vars)
LOG_LEVEL=info
LOG_JSON=

# ── Coordinator ───────────────────────────────────────────────────────────────

# API keys gating the coordinator's HTTP surface (C4). Comma-separated;
# clients present one via `Authorization: Bearer <key>` or `x-api-key: <key>`.
# Empty (default) leaves every route open — fine ONLY when COORDINATOR_HOST
# stays loopback. This compose file's coordinator service DOES publish port
# 8000 to the host, so the coordinator now REFUSES TO START with a
# non-loopback COORDINATOR_HOST and no keys here (see coordinator/main.py's
# _refuse_insecure_bind) — set this before `docker compose up` or the
# coordinator container will exit immediately with an explanatory error.
# Generate one with e.g. `openssl rand -hex 32`.
COORDINATOR_API_KEYS=

# Allowed CORS origins beyond the coordinator's own host, comma-separated
# (M3). A loopback origin (http(s)://localhost or 127.0.0.1, any port) is
# ALWAYS allowed regardless of this setting, so browser-based local
# development keeps working with zero config. Leave empty (default) unless a
# browser page on some OTHER origin needs to call this API directly. Set to
# "*" to restore the old fully-open behavior (still forces
# allow_credentials=False — browsers reject "*" + credentials).
# Example: COORDINATOR_CORS_ORIGINS=https://myapp.example.com
COORDINATOR_CORS_ORIGINS=

# Manual worker registration via POST /v1/workers/manual (C3). Off by
# default — this route lets a caller point the coordinator at an arbitrary
# host:port, which then self-reports loaded_models and can be selected for
# real traffic (prompt exfiltration / poisoned completions), and the address
# is also dialed directly (SSRF). Most deployments never need this —
# COORDINATOR_STATIC_WORKERS below covers the documented single-host/LAN
# setups. When enabled, the route ALSO independently requires a valid
# COORDINATOR_API_KEYS credential, regardless of whether auth is enabled for
# the rest of the API.
COORDINATOR_ALLOW_MANUAL_WORKER_REGISTRATION=false
# Optional allowlist of hosts/CIDRs POST /v1/workers/manual may register,
# comma-separated (e.g. "192.168.1.0/24,worker-3.lan"). Empty (default)
# accepts any well-formed host:port once the feature above is enabled.
COORDINATOR_MANUAL_WORKER_ALLOWED_HOSTS=

# Allow POST /v1/models/load for a model_name absent from config/models.toml
# (H4). Off by default: an unregistered model_name is otherwise sent to the
# worker as an arbitrary HuggingFace repo id to download and load. Enable
# only if you deliberately want ad hoc HF pulls by name.
COORDINATOR_ALLOW_UNREGISTERED_MODEL_PULL=false

# Maximum HTTP request body size in bytes (H5). 25 MB default.
COORDINATOR_MAX_REQUEST_BODY_BYTES=25000000

# ── Monitoring ────────────────────────────────────────────────────────────────

# Grafana admin credentials (GRAFANA_ADMIN_PASSWORD is required — no default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Integrations ─────────────────────────────────────────────────────────────

# API key passed to Open-WebUI for calls to the coordinator's /v1 endpoint
OPENAI_API_KEY=

# Open-WebUI's own login screen (M11). Defaults to True (secure) — was
# hardcoded False ("disable login screen for local network"). Its port
# (8080) also isn't published by default anymore (see
# docker-compose.expose-ports.yml); only set this to False if you've
# deliberately decided this instance never leaves a trusted LAN.
WEBUI_AUTH=True