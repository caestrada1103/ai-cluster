# AI Cluster Environment Configuration
# ======================================
# Copy this file to .env and adjust for your setup.

# ── Which worker to build/run ───────────────────────────────────────────────
# Uncomment exactly ONE profile below to match your hardware, or pass
# --profile <name> on the CLI. None active = no worker starts. See docs/deployment.md.
#
# COMPOSE_PROFILES=amd-vulkan       # AMD (e.g. RX 9060XT) — universal Vulkan image
# COMPOSE_PROFILES=nvidia-vulkan    # NVIDIA (e.g. RTX 3080, or DGX Spark as a fallback) — universal Vulkan image
# COMPOSE_PROFILES=intel-vulkan     # Intel iGPU/dGPU — universal Vulkan image (Mesa ANV)
# COMPOSE_PROFILES=rocm-native      # AMD, native ROCm build — best AMD performance
# COMPOSE_PROFILES=cuda-native      # NVIDIA, native CUDA build (incl. DGX Spark/sm_121) — best NVIDIA performance
COMPOSE_PROFILES=

# ── Worker ────────────────────────────────────────────────────────────────────

# GPU index for the default worker (0-based)
GPU_INDEX=0

# Base ports — each worker replica listens on BASE + GPU_INDEX.
GRPC_BASE_PORT=50051
METRICS_BASE_PORT=9091
# Explicit port overrides (leave empty to derive from BASE + GPU_INDEX).
# No worker port is published to the host by default; layer
# docker-compose.expose-ports.yml to publish them. See docs/deployment.md.
GRPC_PORT=
METRICS_PORT=

# Shared-secret gRPC auth (worker/src/grpc_auth.rs) — the worker's gRPC
# server has no TLS/mTLS, so this is the deliverable in its place. Leave
# empty for a single-host compose deployment; required once the worker's
# gRPC port is published or reached from another host. Generate with
# `openssl rand -hex 32`.
WORKER_GRPC_AUTH_TOKEN=

# Bind hosts for the worker's gRPC server and spawned llama-server children.
# Both default to 127.0.0.1 (secure by default); docker-compose.yml sets
# both to 0.0.0.0 per worker service so the coordinator container can reach
# them over the private compose network. Only change these directly for a
# bare-metal run reachable from another host. See docs/deployment.md.
WORKER_GRPC_BIND_HOST=
LLAMASERVER_BIND_HOST=

# HuggingFace Hub token for gated model downloads
HF_TOKEN=

# Logging level
RUST_LOG=info

# Rust panic backtrace (set to `full` for verbose output)
RUST_BACKTRACE=1

# Unique worker identifier (auto-assigned if empty)
WORKER_ID=

# Explicit VRAM override in GB — takes precedence over detection. Leave
# empty (default) to let the worker detect it (CUDA driver/vendor tool, with
# a headroom-adjusted fallback on unified-memory hardware — see below).
GPU_VRAM_GB=

# On unified-memory hardware (e.g. DGX Spark), the vendor "free" figure can
# understate what's really available by tens of GB, so the worker instead
# reports (100 - this)% of total system RAM as available. Default 15.
GPU_MEMORY_HEADROOM_PERCENT=

# Comma-separated GPU device indices for one worker process (CLI --gpu-ids equivalent)
GPU_IDS=

# Worker log level and JSON logging toggle (clap env vars)
LOG_LEVEL=info
LOG_JSON=

# ── Coordinator ───────────────────────────────────────────────────────────────

# API keys gating the coordinator's HTTP surface. Comma-separated; clients
# present one via `Authorization: Bearer <key>` or `x-api-key: <key>`. Empty
# (default) leaves every route open — fine only when COORDINATOR_HOST stays
# loopback; a non-loopback host with no keys here refuses to start. Generate
# with `openssl rand -hex 32`.
COORDINATOR_API_KEYS=

# Optional path to a TOML file assigning a role and model list to individual
# keys, layered on top of COORDINATOR_API_KEYS above. Shape:
#   [keys.ci-runner]
#   key = "3f9a..."
#   role = "user"                   # "admin" or "user"; default "user"
#   models = ["qwen2.5-0.5b-gguf"]  # omitted or [] == unrestricted
#
#   [keys.ops]
#   key = "b711..."
#   role = "admin"
# Empty (default): COORDINATOR_API_KEYS keeps behaving exactly as today,
# every key admin/unrestricted. Set: file entries define identity; a key
# only in COORDINATOR_API_KEYS gets role="user"/unrestricted, and a key
# listed in both uses the file entry.
COORDINATOR_API_KEY_FILE=

# Best-effort: pin each resolved caller to a consistent llama-server
# conversation slot (id_slot), so repeat requests tend to reuse cached
# prompt state. Only takes effect for a model configured with more than
# one conversation slot ([models.X.llamaserver] instances/parallel >= 2)
# and only once COORDINATOR_API_KEY_FILE above is set. Default true.
COORDINATOR_LLAMASERVER_SLOT_AFFINITY=true

# Allowed CORS origins beyond the coordinator's own host, comma-separated. A
# loopback origin is always allowed regardless of this setting. "*" restores
# the fully-open behavior (still forces allow_credentials=False).
# Example: COORDINATOR_CORS_ORIGINS=https://myapp.example.com
COORDINATOR_CORS_ORIGINS=

# Manual worker registration via POST /v1/workers/manual. Off by default —
# this route lets a caller point the coordinator at an arbitrary host:port
# for real traffic (SSRF risk). COORDINATOR_STATIC_WORKERS below covers the
# documented setups. Always independently requires COORDINATOR_API_KEYS when enabled.
COORDINATOR_ALLOW_MANUAL_WORKER_REGISTRATION=false
# Optional allowlist of hosts/CIDRs POST /v1/workers/manual may register,
# comma-separated (e.g. "192.168.1.0/24,worker-3.lan"). Empty accepts any
# well-formed host:port once the feature above is enabled.
COORDINATOR_MANUAL_WORKER_ALLOWED_HOSTS=

# Allow POST /v1/models/load for a model_name absent from config/models.toml.
# Off by default: an unregistered name is otherwise sent to the worker as an
# arbitrary HuggingFace repo id to download and load.
COORDINATOR_ALLOW_UNREGISTERED_MODEL_PULL=false

# Maximum HTTP request body size in bytes. 25 MB default.
COORDINATOR_MAX_REQUEST_BODY_BYTES=25000000

# ── Monitoring ────────────────────────────────────────────────────────────────

# Grafana admin credentials (GRAFANA_ADMIN_PASSWORD is required — no default)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Integrations ─────────────────────────────────────────────────────────────

# API key passed to Open-WebUI for calls to the coordinator's /v1 endpoint
OPENAI_API_KEY=

# Open-WebUI's own login screen. Defaults to True; only set False if this
# instance never leaves a trusted LAN (its port isn't published by default either).
WEBUI_AUTH=True