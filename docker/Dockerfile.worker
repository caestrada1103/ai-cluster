# Parameterized multi-stage build for the Rust worker.
# =====================================================
# One Dockerfile, three variants (see docker-compose.yml commented blocks):
#
#   Universal wgpu/Vulkan (default — AMD + NVIDIA + Intel):
#     docker build -f docker/Dockerfile.worker -t ai-worker:latest .
#
#   AMD native ROCm base:
#     docker build -f docker/Dockerfile.worker -t ai-worker-amd:latest \
#       --build-arg BACKEND=rocm \
#       --build-arg BUILDER_IMAGE=rocm/dev-ubuntu-24.04:6.2.1 \
#       --build-arg RUNTIME_IMAGE=rocm/dev-ubuntu-24.04:6.2.1 \
#       --build-arg BUILDER_EXTRA_PKGS="" \
#       --build-arg RUNTIME_EXTRA_PKGS="" .
#
#   NVIDIA native CUDA base:
#     docker build -f docker/Dockerfile.worker -t ai-worker-nvidia:latest \
#       --build-arg BACKEND=cuda \
#       --build-arg BUILDER_IMAGE=nvidia/cuda:13.0.3-devel-ubuntu24.04 \
#       --build-arg RUNTIME_IMAGE=nvidia/cuda:13.0.3-runtime-ubuntu24.04 \
#       --build-arg BUILDER_EXTRA_PKGS="" \
#       --build-arg RUNTIME_EXTRA_PKGS="libcublas-13-0" .
#     CUDA 13.0.3 (not 12.6): 12.6's nvcc predates sm_121 (Grace-Blackwell GB10,
#     e.g. DGX Spark) support. 13.0.x devel+runtime tags are multi-arch
#     (linux/amd64 + linux/arm64), so RTX 3080 and DGX Spark share the same tags.
#
# GPU passthrough (unchanged conventions):
#   AMD    → mount /dev/kfd + /dev/dri, group_add: [video, render]
#   NVIDIA → deploy.resources.reservations.devices (NVIDIA Container Toolkit)
#   Intel  → works with the default image via Mesa ANV
#
# Docker Desktop on Windows (WSL2) NVIDIA limitation: the WSL2 driver exposes
# CUDA but injects no Vulkan ICD — wgpu falls back to llvmpipe (CPU). Use the
# BACKEND=cuda variant there.
#
# llama-server (agentic serving, engine="llamaserver"): all variants also bake
# in a `llama-server` binary (Stage 2), built with the Vulkan backend from a
# pinned llama.cpp release, for real tool calling that the in-process
# llama.cpp engine can't do. To skip the (heavy) llama.cpp compile, pass
# --build-arg LLAMASERVER_SRC=llamaserver-none. See docs/deployment.md.
#
# Node.js is required to build Stage 2 (see Stage 2 comments for why
# -DLLAMA_BUILD_UI=OFF alone doesn't avoid this).

ARG BUILDER_IMAGE=ubuntu:24.04
ARG RUNTIME_IMAGE=ubuntu:24.04
# Pinned llama.cpp release for the bundled llama-server (Stage 2). b9941 was
# released 2026-07-09 (https://github.com/ggml-org/llama.cpp/releases/tag/b9941),
# well after the mid-March-2026 tool_calls `arguments` bug (issue #20198, fixed in
# PR #20213). Keep any bump at or beyond that fix.
ARG LLAMASERVER_TAG=b9941

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM ${BUILDER_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG BACKEND=wgpu
# Extra cargo features appended to BACKEND (default: none = pure Burn/wgpu image).
# For the llama.cpp GGUF engine build with one of:
#   --build-arg WORKER_FEATURES="llamacpp,llamacpp-vulkan"                         (wgpu base, Vulkan offload)
#   --build-arg BACKEND=cuda --build-arg WORKER_FEATURES="llamacpp,llamacpp-cuda"  (CUDA base, CUDA offload)
# llama.cpp is compiled from source: needs clang/libclang-dev (bindgen) + glslc
# (Vulkan shaders), added to the builder below; libgomp1 is added to the runtime.
ARG WORKER_FEATURES=""
# Vulkan headers are needed for the default wgpu build; vendor bases ship their own stacks.
ARG BUILDER_EXTRA_PKGS="libvulkan-dev mesa-vulkan-drivers"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    clang \
    libclang-dev \
    glslc \
    pkg-config \
    libssl-dev \
    curl \
    gnupg \
    git \
    protobuf-compiler \
    ca-certificates \
    ${BUILDER_EXTRA_PKGS} \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.89 \
    && . "$HOME/.cargo/env"

ENV PATH="/root/.cargo/bin:${PATH}"
# Vendor toolchain locations — harmless no-ops on images that lack them.
ENV ROCM_PATH=/opt/rocm \
    CUDA_HOME=/usr/local/cuda
ENV PATH="${ROCM_PATH}/bin:${CUDA_HOME}/bin:${PATH}" \
    LD_LIBRARY_PATH="${ROCM_PATH}/lib:${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"

WORKDIR /build

# Copy manifest files first so the dependency layer is cached independently
# Cargo.lock lives at the workspace root, not inside worker/
COPY worker/Cargo.toml ./Cargo.toml
COPY Cargo.lock ./Cargo.lock
COPY worker/build.rs ./

# Proto files are needed by build.rs for tonic code generation
COPY proto ../proto/

# Dummy source so cargo can fetch and compile dependencies without real code
# Note: do NOT create src/lib.rs — Cargo auto-detects it as a lib target and
# the build would link against a dummy stub.
RUN mkdir src && echo "fn main() {}" > src/main.rs

# Build dependencies (cached layer — only invalidated by Cargo.toml changes)
RUN cargo build --release --features="${BACKEND}${WORKER_FEATURES:+,${WORKER_FEATURES}}"

# Copy real source and do the final build
COPY worker/src ./src/
COPY worker/models ./models/

RUN touch src/main.rs && cargo build --release --features="${BACKEND}${WORKER_FEATURES:+,${WORKER_FEATURES}}"


# ── Stage 2: llama-server (agentic serving, engine="llamaserver") ──
# Builds ONLY the `llama-server` target from the PINNED llama.cpp tag, Vulkan backend:
#   -DGGML_VULKAN=ON        Vulkan backend
#   -DLLAMA_BUILD_SERVER=ON gate for the tools/server `llama-server` target
#   -DBUILD_SHARED_LIBS=OFF static link, so one self-contained binary can be copied out
#   -DLLAMA_CURL=OFF        worker always passes a local -m <gguf path>; drops the libcurl dep
#   -DGGML_NATIVE=OFF       no -march=native, so the image is portable across the fleet's CPUs
#   -DLLAMA_BUILD_TESTS=OFF only the server target is needed
#
# Node.js is required: tools/CMakeLists.txt always builds the embedded Web UI
# when LLAMA_BUILD_SERVER=ON (-DLLAMA_BUILD_UI=OFF does not skip it — it just
# falls back to a network-dependent HF-bucket download we don't want to rely
# on). vite 7 needs Node 20.19+/22.12+, newer than Ubuntu 24.04's apt nodejs;
# provisioned instead via multi-stage COPY from the official `node` image.
# Full rationale: docs/deployment.md.
FROM node:22-bookworm-slim AS node-toolchain

FROM ${BUILDER_IMAGE} AS llamaserver-build

ARG DEBIAN_FRONTEND=noninteractive
ARG LLAMASERVER_TAG

# glslc + spirv-headers compile the Vulkan compute shaders (no GPU needed to
# build); libvulkan-dev links the loader.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    glslc \
    spirv-headers \
    libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

# Node 22 for the embedded Web UI's npm build (see the Stage 2 comment above).
COPY --from=node-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=node-toolchain /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    node --version && npm --version

# Shallow single-tag clone → small, cache-friendly layer.
RUN git clone --depth 1 --branch "${LLAMASERVER_TAG}" \
    https://github.com/ggml-org/llama.cpp.git /opt/llama.cpp

WORKDIR /opt/llama.cpp
RUN cmake -B build \
    -DGGML_VULKAN=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DLLAMA_CURL=OFF \
    -DGGML_NATIVE=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_UI=ON \
    && cmake --build build --target llama-server -j "$(nproc)" \
    && cp build/bin/llama-server /llama-server \
    && strip /llama-server

# No-op alternative for a pure-Burn / CPU-only image: build with
#   --build-arg LLAMASERVER_SRC=llamaserver-none
# BuildKit then prunes the (unreferenced) llamaserver-build stage above, so none
# of the llama.cpp compile runs. The stub keeps the runtime COPY valid and fails
# LOUDLY (exit 127) if an engine="llamaserver" model is ever loaded on such an
# image — the worker's HTTP health-check sees the child exit during startup.
FROM ${BUILDER_IMAGE} AS llamaserver-none
RUN printf '#!/bin/sh\necho "llama-server not built into this image (LLAMASERVER_SRC=llamaserver-none); rebuild the default universal worker image to serve engine=llamaserver models" >&2\nexit 127\n' > /llama-server \
    && chmod +x /llama-server


# ── Stage 3: Runtime ────────────────────────────────────────────────────────
FROM ${RUNTIME_IMAGE} AS runtime

ARG DEBIAN_FRONTEND=noninteractive
# Default (wgpu) runtime needs the Vulkan loader + Mesa drivers; vendor images override.
ARG RUNTIME_EXTRA_PKGS="libvulkan1 mesa-vulkan-drivers vulkan-tools"

LABEL maintainer="Carlos Estrada <caestrada1103@gmail.com>"
LABEL description="AI Cluster Worker"
LABEL version="0.1.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libssl3 \
    libgomp1 \
    ${RUNTIME_EXTRA_PKGS} \
    && rm -rf /var/lib/apt/lists/*

# NVIDIA Container Toolkit: expose GPU + inject Vulkan ICD when running on NVIDIA.
# On AMD/Intel these variables are ignored.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Create non-root user (handle existing UID 1000 in Ubuntu 24.04 base)
RUN if getent passwd 1000; then userdel -f $(getent passwd 1000 | cut -d: -f1); fi && \
    if getent group 1000; then groupdel $(getent group 1000 | cut -d: -f1); fi && \
    groupadd -r -g 1000 worker && \
    useradd -r -g worker -u 1000 -m -d /app worker

ENV ROCM_PATH=/opt/rocm \
    LD_LIBRARY_PATH="/opt/rocm/lib:${LD_LIBRARY_PATH:-}" \
    RUST_LOG=info \
    RUST_BACKTRACE=1 \
    WORKER_ID= \
    GPU_INDEX=0 \
    GRPC_BASE_PORT=50051 \
    METRICS_BASE_PORT=9091

RUN mkdir -p /app/config /app/models /app/data /app/logs /tmp/worker && \
    chown -R worker:worker /app /tmp/worker

WORKDIR /app

COPY --from=builder --chown=worker:worker /build/target/release/ai-worker /usr/local/bin/

# llama-server for agentic serving (engine="llamaserver"), from Stage 2.
# Statically linked, so the single binary is self-contained (it still uses the
# Vulkan LOADER libvulkan1 + mesa-vulkan-drivers installed above, plus libgomp1).
# LLAMASERVER_SRC selects the real build (default) or the no-op stub — see Stage 2.
ARG LLAMASERVER_SRC=llamaserver-build
COPY --from=${LLAMASERVER_SRC} /llama-server /usr/local/bin/llama-server
# The worker spawns this per engine="llamaserver" model. Env wins over
# worker.toml's llamaserver_binary_path (whose default is "llama-server" on PATH).
ENV LLAMASERVER_BINARY_PATH=/usr/local/bin/llama-server

COPY --chown=worker:worker config/worker.toml /app/config/
COPY --chown=worker:worker config/models.toml /app/config/
COPY --chown=worker:worker docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

USER worker

# Shell-form arithmetic: healthchecks do NOT see entrypoint exports, so recompute
# the per-replica metrics port here (base + GPU index).
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:$(( ${METRICS_BASE_PORT:-9091} + ${GPU_INDEX:-0} ))/health || exit 1

EXPOSE 50051-50058
EXPOSE 9091-9098
# llama-server registry ports: one per engine="llamaserver" model in
# config/models.toml. The coordinator — possibly on another host — proxies
# agentic HTTP inference to worker_host:<port>; that hop is unauthenticated,
# so restrict exposure to the trusted LAN. See docs/deployment.md.
EXPOSE 8081-8085

ENTRYPOINT ["/app/entrypoint.sh"]
